{
  "name": "blast",
  "private": true,
  "description": "Blast guardrail drawer MVP.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/blast.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run eslint:check",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "eslint:check": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "format": "prettier --write . --cache --cache-location node_modules/.cache/prettier/.prettiercache",
    "format:check": "turbo run prettier:check",
    "prettier:check": "prettier --check . --cache --cache-location node_modules/.cache/prettier/.prettiercache",
    "audit:check": "pnpm audit --audit-level=high --ignore-registry-errors",
    "dedupe:check": "pnpm dedupe --check",
    "sherif:check": "sherif --fail-on-warnings",
    "knip:check": "knip",
    "verify": "rxova-repo-config verify",
    "prepare": "husky",
    "dev": "pnpm --filter @blast/web dev"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@rxova/repo-config": "^0.5.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "sherif": "^1.13.0",
    "turbo": "^2.11.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "repoConfig": {
    "verify": {
      "steps": [
        {
          "name": "lint",
          "command": "pnpm lint"
        },
        {
          "name": "format",
          "command": "pnpm format:check"
        },
        {
          "name": "build",
          "command": "pnpm exec turbo run build"
        },
        {
          "name": "typecheck",
          "command": "pnpm exec turbo run typecheck"
        },
        {
          "name": "unit tests",
          "command": "pnpm exec turbo run test"
        },
        {
          "name": "dependency versions",
          "command": "pnpm run sherif:check"
        },
        {
          "name": "unused code",
          "command": "pnpm run knip:check"
        },
        {
          "name": "dependency dedupe",
          "command": "pnpm exec turbo run //#dedupe:check"
        },
        {
          "name": "audit",
          "command": "pnpm run audit:check"
        }
      ]
    }
  }
}
